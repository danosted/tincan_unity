/*
 * TinCan UI theme. Every screen layer (IUiLayers) loads this sheet, so all screen UI takes its look from here.
 * Change the tokens below to restyle the game; the classes further down only use tokens, never literal values.
 * Rules: views add classes (tc-*), they do not set colors, spacing or font sizes in code. See .docs/UI_FRAMEWORK.md,
 * "Theme".
 */

/* ---------- Tokens ---------- */
.tc-root {
    /* Surfaces */
    --tc-surface-panel: rgba(16, 18, 24, 0.94);
    --tc-surface-card: rgba(24, 27, 34, 0.86);
    --tc-surface-hud: rgba(40, 42, 48, 0.78);
    --tc-surface-control: rgb(44, 49, 60);
    --tc-surface-control-hover: rgb(56, 63, 78);
    --tc-surface-control-active: rgb(38, 86, 110);
    --tc-surface-input: rgb(10, 12, 16);
    --tc-surface-track: rgba(0, 0, 0, 0.55);
    --tc-backdrop: rgba(0, 0, 0, 0.45);

    /* Text */
    --tc-text: rgb(232, 235, 240);
    --tc-text-muted: rgb(160, 168, 180);
    --tc-text-on-accent: rgb(10, 14, 20);

    /* Accents and states */
    --tc-accent: rgb(77, 204, 255);
    --tc-accent-soft: rgba(77, 204, 255, 0.25);
    --tc-border: rgba(255, 255, 255, 0.12);
    --tc-border-focus: rgb(77, 204, 255);
    --tc-warning: rgb(255, 191, 77);
    --tc-good: rgb(77, 217, 89);
    --tc-fair: rgb(230, 190, 60);
    --tc-bad: rgb(217, 51, 38);

    /* Spacing, shape, type */
    --tc-space-xs: 2px;
    --tc-space-s: 4px;
    --tc-space-m: 8px;
    --tc-space-l: 16px;
    --tc-space-xl: 24px;
    --tc-radius: 6px;
    --tc-radius-s: 3px;
    --tc-font-xs: 11px;
    --tc-font-s: 13px;
    --tc-font-m: 16px;
    --tc-font-l: 20px;
    --tc-font-title: 28px;
    --tc-control-height: 32px;

    color: var(--tc-text);
    font-size: var(--tc-font-m);
}

/* ---------- Controls (the built-in elements, inside our UI only) ---------- */
.tc-root .unity-label {
    color: var(--tc-text);
}

.tc-root .unity-button {
    background-color: var(--tc-surface-control);
    color: var(--tc-text);
    border-color: var(--tc-border);
    border-width: 1px;
    border-radius: var(--tc-radius-s);
    -unity-text-align: middle-center;
}

.tc-root .unity-button:hover {
    background-color: var(--tc-surface-control-hover);
}

.tc-root .unity-button:active {
    background-color: var(--tc-surface-control-active);
}

.tc-root .unity-button:focus {
    border-color: var(--tc-border-focus);
}

.tc-root .unity-base-field__label {
    color: var(--tc-text-muted);
    min-width: 160px;
}

/* Text inputs: dark well, light text, so typed text always reads. */
.tc-root .unity-base-text-field__input {
    background-color: var(--tc-surface-input);
    color: var(--tc-text);
    border-color: var(--tc-border);
    border-width: 1px;
    border-radius: var(--tc-radius-s);
    padding-left: var(--tc-space-s);
    padding-right: var(--tc-space-s);
    --unity-cursor-color: var(--tc-accent);
    --unity-selection-color: var(--tc-accent-soft);
}

.tc-root .unity-base-text-field__input:focus {
    border-color: var(--tc-border-focus);
}

.tc-root .unity-base-text-field__input > .unity-text-element {
    color: var(--tc-text);
}

.tc-root .unity-toggle__checkmark {
    background-color: var(--tc-surface-input);
    border-color: var(--tc-border);
    -unity-background-image-tint-color: var(--tc-accent);
}

.tc-root .unity-base-slider__tracker {
    background-color: var(--tc-surface-track);
    border-color: var(--tc-border);
}

.tc-root .unity-base-slider__dragger {
    background-color: var(--tc-accent);
    border-color: var(--tc-accent);
}

.tc-root .unity-scroller {
    opacity: 0.6;
}

/* ---------- Menus ---------- */
.tc-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--tc-backdrop);
}

.tc-menu {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    min-width: 360px;
    max-height: 92%;
    padding: var(--tc-space-l) var(--tc-space-xl);
    background-color: var(--tc-surface-panel);
    border-color: var(--tc-border);
    border-width: 1px;
    border-radius: var(--tc-radius);
}

.tc-menu__title {
    font-size: var(--tc-font-title);
    -unity-font-style: bold;
    margin-bottom: var(--tc-space-l);
    color: var(--tc-text);
}

.tc-menu__rows {
    flex-shrink: 1;
}

.tc-menu__button {
    height: var(--tc-control-height);
    margin-top: var(--tc-space-s);
}

.tc-menu__binding {
    height: 22px;
    margin-top: 1px;
    -unity-text-align: middle-left;
}

.tc-menu__field {
    margin-top: var(--tc-space-s);
}

.tc-menu__note {
    margin-top: var(--tc-space-m);
    color: var(--tc-warning);
    white-space: normal;
}

.tc-menu__choice {
    flex-direction: row;
    align-items: center;
    margin-top: var(--tc-space-s);
}

.tc-menu__choice-label {
    flex-grow: 1;
    color: var(--tc-text-muted);
}

.tc-menu__choice-value {
    min-width: 100px;
    -unity-text-align: middle-center;
    color: var(--tc-accent);
}

.tc-menu__choice-arrow {
    width: 28px;
    height: 24px;
}

/* ---------- HUD ---------- */
.tc-hud {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: var(--tc-space-m) 12px;
    background-color: var(--tc-surface-hud);
    border-radius: var(--tc-radius);
}

.tc-hud__line {
    font-size: var(--tc-font-l);
}

.tc-meter {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--tc-space-s);
}

.tc-meter__label {
    font-size: var(--tc-font-l);
    width: 80px;
}

.tc-meter__track {
    width: 240px;
    height: 16px;
    background-color: var(--tc-surface-track);
    border-color: var(--tc-text);
    border-width: 1px;
}

.tc-meter__fill {
    height: 100%;
    background-color: var(--tc-good);
}

.tc-meter__fill--fair {
    background-color: var(--tc-fair);
}

.tc-meter__fill--bad {
    background-color: var(--tc-bad);
}

/* ---------- Feature panels ---------- */
.tc-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A column of cards down the right edge (the shipyard's parts and controls). */
.tc-side-column {
    position: absolute;
    right: 12px;
    top: 12px;
    bottom: 12px;
    width: 300px;
    flex-direction: column;
    justify-content: space-between;
}

.tc-card--fill {
    flex-shrink: 1;
    min-height: 0;
}

.tc-card--below {
    margin-top: var(--tc-space-m);
    flex-shrink: 0;
}

.tc-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.tc-card {
    flex-direction: column;
    padding: var(--tc-space-m) 10px;
    background-color: var(--tc-surface-card);
    border-radius: var(--tc-radius);
}

.tc-heading {
    -unity-font-style: bold;
    color: var(--tc-text-muted);
    margin-top: var(--tc-space-s);
}

.tc-hint {
    white-space: normal;
    color: var(--tc-text-muted);
}

.tc-tabs {
    flex-direction: row;
    margin-bottom: 6px;
}

.tc-tab {
    flex-grow: 1;
    height: 26px;
    color: var(--tc-text-muted);
}

.tc-tab--active {
    background-color: var(--tc-surface-control-active);
    color: var(--tc-text);
    -unity-font-style: bold;
}

.tc-tile {
    width: 84px;
    height: 104px;
    margin: var(--tc-space-xs);
    padding: var(--tc-space-xs);
    flex-direction: column;
    align-items: center;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.tc-tile--selected {
    border-color: var(--tc-accent);
}

.tc-tile__picture {
    width: 76px;
    height: 76px;
}

.tc-tile__name {
    font-size: var(--tc-font-xs);
    white-space: normal;
    -unity-text-align: middle-center;
}

.tc-tile--selected .tc-tile__name {
    color: var(--tc-accent);
}

.tc-keys {
    flex-direction: row;
    margin-bottom: 1px;
}

.tc-keys__key {
    width: 120px;
    -unity-font-style: bold;
    color: var(--tc-accent);
    white-space: normal;
}

.tc-keys__action {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* ---------- Dev ---------- */
.tc-dev-readout {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 560px;
    min-height: 210px;
    padding: 6px;
    font-size: var(--tc-font-s);
    white-space: normal;
    background-color: rgba(0, 0, 0, 0.6);
}
